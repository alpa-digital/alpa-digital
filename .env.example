# Funciones de servidor (netlify/functions). Configurar en el panel de Netlify, nunca en el repositorio.

# Análisis de webs con Mistral (/api/analyze)
MISTRAL_API_KEY=
# Opcional. Por defecto mistral-small-latest.
MISTRAL_MODEL=

# Envío de informes y avisos de leads con Resend (/api/lead)
RESEND_API_KEY=
LEAD_FROM_EMAIL="Alpa Digital <info@alpa.digital>"
LEAD_TO_EMAIL=info@alpa.digital
