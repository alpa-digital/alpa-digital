# Funciones de servidor (netlify/functions). Configurar en el panel de Netlify, nunca en el repositorio.

# Análisis de webs (/api/analyze). Proveedor recomendado: OpenAI.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_FALLBACK_MODEL=gpt-4.1-mini

# Alternativa: Mistral (se usa solo si no hay OPENAI_API_KEY)
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_FALLBACK_MODEL=open-mistral-nemo

# Para usar otro proveedor compatible con la API de OpenAI, define estas tres en lugar de las de Mistral.
# Ejemplos: OpenAI https://api.openai.com/v1 (gpt-4o-mini) · Groq https://api.groq.com/openai/v1 (llama-3.3-70b-versatile)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_FALLBACK_MODEL=
# Opcional. Por defecto mistral-small-latest.
MISTRAL_MODEL=

# Envío de informes y avisos de leads con Resend (/api/lead)
RESEND_API_KEY=
LEAD_FROM_EMAIL="Alpa Digital <info@alpa.digital>"
LEAD_TO_EMAIL=info@alpa.digital

# Solo si la web se publica en un hosting sin funciones: URL de los webhooks de n8n
# (se leen en tiempo de build por Vite).
VITE_ANALYZE_ENDPOINT=
VITE_LEAD_ENDPOINT=
